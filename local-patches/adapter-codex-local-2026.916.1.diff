+// Local trusted-instance patch: quota reserve gate. Instead of fixed per-agent
+// daily run caps, refuse to start Codex once any provider quota window is at or
+// above the reserve line, leaving the remainder for the operator. The refusal is
+// reported as a provider_quota failure with retryNotBefore set to the window
+// reset, so the server's durable scheduled-retry path resumes the work later
+// (a skipped wake would be dropped). Quota lookup failures fail open: the run
+// proceeds and Codex's own quota errors remain the hard backstop.
+const CODEX_QUOTA_RESERVE_DEFAULT_PERCENT = 80;
+const CODEX_QUOTA_CACHE_TTL_MS = 5 * 60 * 1000;
+const CODEX_QUOTA_LOOKUP_TIMEOUT_MS = 20_000;
+const CODEX_QUOTA_FALLBACK_RETRY_MS = 30 * 60 * 1000;
+let codexQuotaCache = null;
+async function readCachedCodexQuota() {
+    const now = Date.now();
+    if (codexQuotaCache && now - codexQuotaCache.fetchedAt < CODEX_QUOTA_CACHE_TTL_MS) {
+        return codexQuotaCache.result;
+    }
+    let timeoutId = null;
+    try {
+        const result = await Promise.race([
+            getQuotaWindows(),
+            new Promise((_, reject) => {
+                timeoutId = setTimeout(() => reject(new Error(`quota lookup timed out after ${CODEX_QUOTA_LOOKUP_TIMEOUT_MS / 1000}s`)), CODEX_QUOTA_LOOKUP_TIMEOUT_MS);
+            }),
+        ]);
+        if (result?.ok)
+            codexQuotaCache = { fetchedAt: now, result };
+        return result;
+    }
+    finally {
+        if (timeoutId)
+            clearTimeout(timeoutId);
+    }
+}
+export function evaluateCodexQuotaReserve(quota, reservePercent, now = new Date()) {
+    const exhausted = (quota?.windows ?? []).filter((w) => typeof w.usedPercent === "number" && w.usedPercent >= reservePercent);
+    if (!exhausted.length)
+        return null;
+    const resets = exhausted
+        .map((w) => (w.resetsAt ? new Date(w.resetsAt).getTime() : NaN))
+        .filter((t) => Number.isFinite(t) && t > now.getTime());
+    const retryAt = resets.length
+        ? new Date(Math.max(...resets))
+        : new Date(now.getTime() + CODEX_QUOTA_FALLBACK_RETRY_MS);
+    const detail = exhausted.map((w) => `${w.label} ${w.usedPercent}%`).join(", ");
+    return { retryNotBefore: retryAt.toISOString(), detail };
+}
+async function checkCodexQuotaReserve(config, onLog) {
